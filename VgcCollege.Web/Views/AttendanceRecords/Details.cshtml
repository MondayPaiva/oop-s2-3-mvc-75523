@model VgcCollege.Web.Models.AttendanceRecord

@{
    ViewData["Title"] = "Attendance Details";
}

<h1>Attendance Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Student:</strong> @(Model.CourseEnrolment?.StudentProfile?.Name ?? "-")</p>
        <p><strong>Course:</strong> @(Model.CourseEnrolment?.Course?.Name ?? "-")</p>
        <p><strong>Session Date:</strong> @Model.SessionDate.ToShortDateString()</p>
        <p><strong>Present:</strong> @(Model.Present ? "Yes" : "No")</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>