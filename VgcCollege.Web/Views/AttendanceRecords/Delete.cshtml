@model VgcCollege.Web.Models.AttendanceRecord

@{
    ViewData["Title"] = "Delete Attendance";
}

<h1>Delete Attendance</h1>

<h3>Are you sure you want to delete this?</h3>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Student:</strong> @(Model.CourseEnrolment?.StudentProfile?.Name ?? "-")</p>
        <p><strong>Course:</strong> @(Model.CourseEnrolment?.Course?.Name ?? "-")</p>
        <p><strong>Session Date:</strong> @Model.SessionDate.ToShortDateString()</p>
        <p><strong>Present:</strong> @(Model.Present ? "Yes" : "No")</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>