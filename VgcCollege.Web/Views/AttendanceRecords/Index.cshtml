@model IEnumerable<VgcCollege.Web.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Attendance Records";
}

<h1>Attendance Records</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Attendance</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Student</th>
        <th>Course</th>
        <th>Session Date</th>
        <th>Present</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.CourseEnrolment?.StudentProfile?.Name ?? "-")</td>
            <td>@(item.CourseEnrolment?.Course?.Name ?? "-")</td>
            <td>@item.SessionDate.ToShortDateString()</td>
            <td>@(item.Present ? "Yes" : "No")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>