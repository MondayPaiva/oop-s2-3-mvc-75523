@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
        <div class="container-fluid py-4">
            <h1 class="display-5 fw-bold">Welcome to VGC College</h1>
            <p class="col-md-10 fs-5">
                This system helps manage branches, courses, students, enrolments, attendance,
                assignments, exams, and academic results in one place.
            </p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <p class="mt-3">
                    <strong>Logged in as:</strong> @User.Identity.Name
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <span class="badge bg-primary fs-6">Admin Access</span>
                }
                else if (User.IsInRole("Faculty"))
                {
                    <span class="badge bg-success fs-6">Faculty Access</span>
                }
                else if (User.IsInRole("Student"))
                {
                    <span class="badge bg-secondary fs-6">Student Access</span>
                }
            }
            else
            {
                <p class="mt-3 text-muted">
                    Please log in to access the system features.
                </p>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Academic Management</h4>
                    <p class="card-text">
                        Manage courses, enrolments, attendance, assignments, and exams efficiently.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Role-Based Access</h4>
                    <p class="card-text">
                        Admin, Faculty, and Student users can access only the features relevant to them.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Results Tracking</h4>
                    <p class="card-text">
                        Track assignment and exam performance while keeping student data protected.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>