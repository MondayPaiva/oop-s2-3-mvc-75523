@model VgcCollege.Web.Models.Branch

@{
    ViewData["Title"] = "Branch Details";
}

<h1>Branch Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Address:</strong> @Model.Address</p>
    </div>
</div>

@if (Model.Courses != null && Model.Courses.Any())
{
    <h4>Courses</h4>
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Course</th>
            <th>Start Date</th>
            <th>End Date</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var course in Model.Courses)
        {
            <tr>
                <td>@course.Name</td>
                <td>@course.StartDate.ToShortDateString()</td>
                <td>@course.EndDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No courses found for this branch.</div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>