@model VgcCollege.Web.Models.Branch

@{
    ViewData["Title"] = "Branch Details";
}

<h1>Branch Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p class="card-text"><strong>Address:</strong> @Model.Address</p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Courses in this Branch</h4>
    <a asp-controller="Courses" asp-action="Create" class="btn btn-primary">Add Course</a>
</div>

@if (Model.Courses != null && Model.Courses.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var course in Model.Courses)
        {
            <tr>
                <td>@course.Name</td>
                <td>@course.StartDate.ToShortDateString()</td>
                <td>@course.EndDate.ToShortDateString()</td>
                <td>
                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No courses found for this branch yet.
    </div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>