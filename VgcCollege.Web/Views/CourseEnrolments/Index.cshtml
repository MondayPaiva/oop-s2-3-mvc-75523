@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>

@{
    ViewData["Title"] = "Course Enrolments";
}

<h1>Course Enrolments</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Enrolment</a>
    </p>
}

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Student</th>
        <th>Course</th>
        <th>Status</th>
        <th>Enrol Date</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.StudentProfile?.Name ?? "-")</td>
            <td>@(item.Course?.Name ?? "-")</td>
            <td>@item.Status</td>
            <td>@item.EnrolDate.ToShortDateString()</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>