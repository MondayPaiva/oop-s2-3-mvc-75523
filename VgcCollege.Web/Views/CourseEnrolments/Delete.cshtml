@model VgcCollege.Web.Models.CourseEnrolment

@{
    ViewData["Title"] = "Delete Enrolment";
}

<h1>Delete Enrolment</h1>

<h3>Are you sure you want to delete this?</h3>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Student:</strong> @(Model.StudentProfile?.Name ?? "-")</p>
        <p><strong>Course:</strong> @(Model.Course?.Name ?? "-")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Enrol Date:</strong> @Model.EnrolDate.ToShortDateString()</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>