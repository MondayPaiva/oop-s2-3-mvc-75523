@model VgcCollege.Web.Models.CourseEnrolment

@{
    ViewData["Title"] = "Enrolment Details";
}

<h1>Enrolment Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Student:</strong> @(Model.StudentProfile?.Name ?? "-")</p>
        <p><strong>Course:</strong> @(Model.Course?.Name ?? "-")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Enrol Date:</strong> @Model.EnrolDate.ToShortDateString()</p>
    </div>
</div>

<h4>Attendance Records</h4>

@if (Model.AttendanceRecords != null && Model.AttendanceRecords.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
        <tr>
            <th>Session Date</th>
            <th>Present</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var record in Model.AttendanceRecords)
        {
            <tr>
                <td>@record.SessionDate.ToShortDateString()</td>
                <td>@(record.Present ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No attendance records found.</div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>