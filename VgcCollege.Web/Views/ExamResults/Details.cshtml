@model VgcCollege.Web.Models.ExamResult

@{
    ViewData["Title"] = "Exam Result Details";
}

<h1>Exam Result Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Exam:</strong> @(Model.Exam?.Title ?? "-")</p>
        <p><strong>Student:</strong> @(Model.StudentProfile?.Name ?? "-")</p>
        <p><strong>Score:</strong> @Model.Score</p>
        <p><strong>Grade:</strong> @Model.Grade</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>