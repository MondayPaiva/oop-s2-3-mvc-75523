@model VgcCollege.Web.Models.Assignment

@{
    ViewData["Title"] = "Assignment Details";
}

<h1>Assignment Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Course:</strong> @(Model.Course?.Name ?? "-")</p>
        <p><strong>Max Score:</strong> @Model.MaxScore</p>
        <p><strong>Due Date:</strong> @Model.DueDate.ToShortDateString()</p>
    </div>
</div>

<h4>Results</h4>

@if (Model.Results != null && Model.Results.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
        <tr>
            <th>Student</th>
            <th>Score</th>
            <th>Feedback</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var result in Model.Results)
        {
            <tr>
                <td>@(result.StudentProfile?.Name ?? "-")</td>
                <td>@result.Score</td>
                <td>@result.Feedback</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No results found.</div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>