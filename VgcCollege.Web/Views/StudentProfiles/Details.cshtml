@model VgcCollege.Web.Models.StudentProfile

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Address:</strong> @Model.Address</p>
        <p><strong>Student Number:</strong> @Model.StudentNumber</p>
    </div>
</div>

<h4>Enrolments</h4>

@if (Model.Enrolments != null && Model.Enrolments.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Course</th>
                <th>Status</th>
                <th>Enrol Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var enrolment in Model.Enrolments)
        {
            <tr>
                <td>@(enrolment.Course?.Name ?? "-")</td>
                <td>@enrolment.Status</td>
                <td>@enrolment.EnrolDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No enrolments found.</div>
}

<h4>Assignment Results</h4>

@if (Model.AssignmentResults != null && Model.AssignmentResults.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Assignment</th>
                <th>Score</th>
                <th>Feedback</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var result in Model.AssignmentResults)
        {
            <tr>
                <td>@(result.Assignment?.Title ?? "-")</td>
                <td>@result.Score</td>
                <td>@result.Feedback</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No assignment results found.</div>
}

<h4>Exam Results</h4>

@if (Model.ExamResults != null && Model.ExamResults.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Exam</th>
                <th>Score</th>
                <th>Grade</th>
                <th>Released</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var result in Model.ExamResults)
        {
            <tr>
                <td>@(result.Exam?.Title ?? "-")</td>
                <td>@result.Score</td>
                <td>@result.Grade</td>
                <td>@((result.Exam?.ResultsReleased ?? false) ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No exam results found.</div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>