@model VgcCollege.Web.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<h1>Course Details</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p><strong>Branch:</strong> @(Model.Branch?.Name ?? "-")</p>
        <p><strong>Faculty:</strong> @(Model.FacultyProfile?.Name ?? "-")</p>
        <p><strong>Start Date:</strong> @Model.StartDate.ToShortDateString()</p>
        <p><strong>End Date:</strong> @Model.EndDate.ToShortDateString()</p>
    </div>
</div>

<h4>Enrolled Students</h4>

@if (Model.Enrolments != null && Model.Enrolments.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Student</th>
                <th>Student Number</th>
                <th>Status</th>
                <th>Enrol Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var enrolment in Model.Enrolments)
        {
            <tr>
                <td>@(enrolment.StudentProfile?.Name ?? "-")</td>
                <td>@(enrolment.StudentProfile?.StudentNumber ?? "-")</td>
                <td>@enrolment.Status</td>
                <td>@enrolment.EnrolDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No enrolled students yet.</div>
}

<h4>Assignments</h4>

@if (Model.Assignments != null && Model.Assignments.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Max Score</th>
                <th>Due Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var assignment in Model.Assignments)
        {
            <tr>
                <td>@assignment.Title</td>
                <td>@assignment.MaxScore</td>
                <td>@assignment.DueDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No assignments yet.</div>
}

<h4>Exams</h4>

@if (Model.Exams != null && Model.Exams.Any())
{
    <table class="table table-bordered table-striped mb-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Max Score</th>
                <th>Released</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var exam in Model.Exams)
        {
            <tr>
                <td>@exam.Title</td>
                <td>@exam.Date.ToShortDateString()</td>
                <td>@exam.MaxScore</td>
                <td>@(exam.ResultsReleased ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No exams yet.</div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>