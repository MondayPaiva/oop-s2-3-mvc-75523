@model VgcCollege.Web.Models.AssignmentResult

@{
    ViewData["Title"] = "Delete Assignment Result";
}

<h1>Delete Assignment Result</h1>

<h3>Are you sure you want to delete this?</h3>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p><strong>Assignment:</strong> @(Model.Assignment?.Title ?? "-")</p>
        <p><strong>Student:</strong> @(Model.StudentProfile?.Name ?? "-")</p>
        <p><strong>Score:</strong> @Model.Score</p>
        <p><strong>Feedback:</strong> @Model.Feedback</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>